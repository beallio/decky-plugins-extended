#!/usr/bin/env bash
# Start one shard-local clamd and export CLAMD_CONFIG_FILE for audit_plugins.py.
# clamscan reloads every signature per release (~8 s); clamd loads them once.
# Packaged units use distro clamd.conf limits (25 MiB MaxFileSize); this config
# keeps ClamAV's built-in limits, matching clamscan.
set -euo pipefail

sudo -n systemctl stop clamav-daemon.socket clamav-daemon.service || true
# Ubuntu's enforced clamd AppArmor profile only lets it create files under /tmp.
clamd_dir="$(mktemp -d /tmp/clamd.XXXXXX)"
clamd_config="$clamd_dir/clamd.conf"
printf '%s\n' \
  "LocalSocket $clamd_dir/clamd.sock" \
  "PidFile $clamd_dir/clamd.pid" \
  "DatabaseDirectory /var/lib/clamav" > "$clamd_config"
clamd --config-file="$clamd_config"
clamdscan --config-file="$clamd_config" --ping=30
clamdscan --config-file="$clamd_config" --version
echo "CLAMD_CONFIG_FILE=$clamd_config" >> "${GITHUB_ENV:?}"
